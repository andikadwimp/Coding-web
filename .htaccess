# ═════════════════════════════════════════════════════════════════════
# URL Rewrite Rules
# ═════════════════════════════════════════════════════════════════════
RewriteEngine On

# Shortcut: /clearcache → /clearcache.php
RewriteRule ^clearcache/?$ clearcache.php [L]

# ═════════════════════════════════════════════════════════════════════
# MIME types untuk PWA & APK
# ═════════════════════════════════════════════════════════════════════
AddType application/manifest+json .webmanifest
AddType application/vnd.android.package-archive .apk

# ═════════════════════════════════════════════════════════════════════
# Disable caching untuk PHP (always fresh)
# ═════════════════════════════════════════════════════════════════════
<FilesMatch "\.(php)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </IfModule>
</FilesMatch>

# Cache aggressive untuk static assets
<FilesMatch "\.(png|jpg|jpeg|gif|webp|svg|ico|woff|woff2|ttf|eot)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "public, max-age=604800"
  </IfModule>
</FilesMatch>
